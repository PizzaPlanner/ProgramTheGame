:root {
    --color-background-tech-default: rgb(42, 55, 80);
    --color-background-tech-unlocked: rgb(42, 85, 70);
    --color-background-tech-selected: rgb(72, 110, 150);
    --color-background-tech-bar-default: rgb(40, 50, 95);
    --color-background-tech-bar-unlocked: rgb(20, 100, 35);
    --color-background-tech-bar-working: rgb(35, 35, 100);
}

TechnologyWindow {
    border-width: 1px;
    border-color: var(--color-border-default);
    background-color: var(--color-background-default);
    color: var(--color-text-default);
    padding: 5px;
    position: absolute;
    align-items: stretch;
    width: 80%;
    height: 80%;
    left: 10%;
    top: 10%;
}

TechnologyWindow > #Header {
    height: 48px;
    justify-content: space-between;
    flex-direction: row;
    padding: 5px;
}

TechnologyButton {
    width: 233px;
    flex-shrink: 0;
    margin: 2px;
    background-color: var(--color-background-tech-default);
}

TechnologyButton.selected {
    border-color: var(--color-border-alt-low);
    background-color: var(--color-background-tech-selected);
}

TechnologyButton.unlocked {
    background-color: var(--color-background-tech-unlocked);
}

TechnologyButton.unlocked > #Cost > PercentProgressBar {
    background-color: var(--color-background-tech-bar-unlocked);
}

TechnologyButton.unlocked > #Cost > .id-button {
    display: none;
}

TechnologyButton > .id-button {
    position: absolute;
    left: 0;
    top: 0;
    width: 64px;
    height: 64px;
    background-color: transparent;
}

TechnologyButton > .id-button > #Frame {
    display: none;
}

TechnologyButton > #Cost {
    flex-direction: row;
    justify-content: flex-end;
    padding: 0 8px;
    height: 32px;
    margin: 1px;
}

TechnologyButton > #Cost > .id-button {
    width: 32px;
    height: 32px;
    background-color: transparent;
    flex-shrink: 0;
}

TechnologyButton > #Cost > .id-button > #Frame {
    display: none;
}

TechnologyButton > #Cost > .id-button > Label {
    -unity-text-align: middle-center;
    font-size: 12px;
}

TechnologyButton > #Cost > Label {
    -unity-text-align: middle-left;
    padding: 0;
    flex-grow: 1;
    flex-shrink: 1;
}

TechnologyButton > #Cost > PercentProgressBar > #Progress {
    background-color: var(--color-background-tech-bar-working);
}

TechnologyButton.unlocked > #Cost > PercentProgressBar > #Progress {
    display: none;
}

TechnologyButton > #Cost > PercentProgressBar {
    height: 100%;
    width: 100%;
    left: 0;
    top: 0;
    position: absolute;
    border-width: 0;
    background-color: var(--color-background-tech-bar-default);
}

Label {
    padding: 5px;
    margin: 0;
}

TechnologyButton > #Unlocks {
    flex-direction: row;
    height: 64px;
    margin-left: 64px;
    flex-wrap: wrap;
}

TechnologyButton > #Unlocks > .id-button {
    width: 32px;
    height: 32px;
}

.research-tree-edge {
    position: absolute;
    width: 2px;
    background-color: white;
}