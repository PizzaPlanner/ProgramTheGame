Wiki {
    border-left-color: rgb(168, 168, 168);
    border-right-color: rgb(168, 168, 168);
    border-top-color: rgb(168, 168, 168);
    border-bottom-color: rgb(168, 168, 168);
    border-top-width: 2px;
    border-right-width: 2px;
    border-bottom-width: 2px;
    border-left-width: 2px;
    border-top-left-radius: 2px;
    border-top-right-radius: 2px;
    border-bottom-right-radius: 2px;
    border-bottom-left-radius: 2px;
    background-color: rgb(82, 82, 82);
    padding-top: 5px;
    padding-right: 5px;
    padding-bottom: 5px;
    padding-left: 5px;
    flex-direction: column;
    position: relative;
    align-items: stretch;
    color: #FFFFFF;
}

Wiki > #Search .unity-base-field__input {
    background-color: rgb(63, 63, 63);
    border-top-width: 1px;
    border-right-width: 1px;
    border-bottom-width: 1px;
    border-left-width: 1px;
    border-left-color: rgb(159, 159, 159);
    border-right-color: rgb(159, 159, 159);
    border-top-color: rgb(159, 159, 159);
    border-bottom-color: rgb(159, 159, 159);
}

MultiColumnListView {
    flex-grow: 1;
}

MultiColumnListView Label {
    padding: 5px;
    margin: 0px;
}

MultiColumnListView .unity-multi-column-view__cell {
    justify-content: center;
}

#Body > Label {
    padding: 10px;
}

#Body > Foldout {
    margin-top: 10px;
    margin-bottom: 10px;
}

#Body Foldout > #unity-content {
    flex-direction: row;
    flex-wrap: wrap;
}

Wiki > #Search {
    margin-top: 0;
    margin-right: 0;
    margin-bottom: 5px;
    margin-left: 0;
}

Wiki > TabView .unity-tab__header {
    background-color: rgb(63, 63, 63);
    border-top-width: 1px;
    border-right-width: 1px;
    border-bottom-width: 1px;
    border-left-width: 1px;
    border-left-color: rgb(159, 159, 159);
    border-right-color: rgb(159, 159, 159);
    border-top-color: rgb(159, 159, 159);
    border-bottom-color: rgb(159, 159, 159);
}

Wiki > TabView {
    flex-grow: 1;
}

Wiki > TabView #References {
    align-items: flex-start;
}

Wiki > TabView #navigate {
    align-items: flex-start;
    flex-direction: row;
    flex-wrap: wrap;
}

WikiTagSearchButton {
    padding: 6px;
    border-width: 1px;
    border-color: rgb(116, 142, 143);
    width: 25%;
    -unity-text-align: middle-center;
    font-size: 16px;
}

WikiSearchResultButton {
    padding: 0;
    border-width: 1px;
    border-color: rgb(143, 138, 116);
    /*min-width: 250px;*/
    flex-direction: row;
    align-items: center;
    margin: 3px;
    align-self: flex-start;

    /*min-width: auto;*/
}

WikiSearchResultButton:hover {
    background-color: rgba(5, 0, 0, 0.2);
}

WikiSearchResultButton > #Icon {
    width: 36px;
    height: 36px;
    /*width: 36px;*/
    /*height: 36px;*/
    border-right-width: 1px;
    border-right-color: rgb(143, 138, 116);
    background-color: rgba(70, 70, 60, 0.4);
}

WikiSearchResultButton > Label {
    margin: 0;
    padding: 0 10px 0 10px;
}

WikiSearchResultButton > #RecipeContent {
    padding-top: 1px;
    padding-right: 1px;
    padding-bottom: 1px;
    padding-left: 1px;
    flex-direction: row;
}

WikiSearchResultButton.tag > #Icon {
    width: 30px;
    height: 30px;
    border-right-color: rgb(48, 143, 183);
    background-color: rgba(20, 70, 100, 0.4);
}

WikiSearchResultButton.tag {
    min-width: auto;
    border-radius: 5px;
    border-color: rgb(48, 143, 183);
    padding: 0;
}

WikiSearchResultButton.tagunit {
    border-top-left-radius: 5px;
    border-color: rgb(233, 120, 50);
}

WikiSearchResultButton.tagunit > #Icon {
    border-color: rgb(233, 120, 50);
}

WikiSearchResultButton.tagitem {
    border-bottom-left-radius: 5px;
    border-top-right-radius: 5px;
    border-color: rgb(13, 111, 222);
}

WikiSearchResultButton.tagitem > #Icon {
    border-color: rgb(13, 111, 222);
}

WikiIdLinkButton {
    padding-top: 4px;
    padding-right: 4px;
    padding-bottom: 4px;
    padding-left: 4px;
    border-top-width: 1px;
    border-right-width: 1px;
    border-bottom-width: 1px;
    border-left-width: 1px;
    border-left-color: rgb(85, 145, 86);
    border-right-color: rgb(85, 145, 86);
    border-top-color: rgb(85, 145, 86);
    border-bottom-color: rgb(85, 145, 86);
}

WikiIdLinkButton.inline {
    padding-top: 0;
    padding-right: 0;
    padding-bottom: 0;
    padding-left: 0;
    border-top-width: 0;
    border-right-width: 0;
    border-bottom-width: 0;
    border-left-width: 0;
}

DetailPage > #Header {
    flex-direction: row;
    align-items: center;
}

DetailPage > #Header > #Title {
    font-size: 20px;
    -unity-font-style: bold;
    -unity-text-align: middle-left;
    margin-right: 40px;
}

DetailPage > #Body {
    padding-top: 5px;
    padding-right: 5px;
    padding-bottom: 5px;
    padding-left: 5px;
}

DetailPage > #Header > #Icon {
    width: 64px;
    height: 64px;
}

Wiki .unity-tab-view__header-container {
    flex-shrink: 0;
}

#Body Foldout#Element > #unity-content {
    flex-direction: column;
    flex-wrap: nowrap;
}

#Body Foldout#Element > Foldout > #unity-content {
    flex-direction: column;
    flex-wrap: nowrap;
}


StateChangeWikiElement {
    flex-direction: row;
}

StateChangeWikiElement > Label {
    -unity-text-align: middle-center;
}

StateChangeWikiElement > Label#Freeze {
    color: rgb(100, 100, 255);
}

StateChangeWikiElement > Label#Melt {
    color: rgb(255, 100, 100);
}

#Body Foldout#Crafting > #unity-content {
    flex-direction: column;
    flex-wrap: nowrap;
}

CraftingRecipeWikiEntry {
    flex-direction: row;
    border-color: rgb(180, 200, 120);
    border-width: 1px;
    align-items: center;
}

CraftingRecipeWikiEntry > VisualElement {
    flex-direction: row;
}