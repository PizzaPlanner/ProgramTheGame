NewBuildingUI {
    position: absolute;
    bottom: 0;
    flex-direction: column-reverse;
    align-self: center;
    padding: 10px;
    color: rgb(240, 250, 250);
}

NewBuildingUI > #Buildings {
    flex-direction: row;
    padding: 10px;
}

BuildingPlanElement > #Anchor {
    position: absolute;
    flex-direction: column-reverse;
    top: -20px;
}

#BuildingVariants {
    position: absolute;
    bottom: 0;
    background-color: rgb(22, 27, 45);
    border-color: rgb(43, 89, 188);
}

#BuildingVariants > #BuildingVariant {
    border-width: 1px;
    border-color: rgb(43, 89, 188);
}