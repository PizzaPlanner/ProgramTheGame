NewBuildingUI {
    position: absolute;
    bottom: 0;
    left: 0;
    padding: 10px;
    color: rgb(240, 250, 250);
}

NewBuildingUI > #Body {
    flex-direction: row;
}

NewBuildingUI > #Header > Label {
    font-size: 16px;
}


NewBuildingUI.with-variants > #Body > #Categories Label {
    display: none;
}
NewBuildingUI.with-variants > #Body > #Categories:hover Label {
    display: flex;
}

NewBuildingUI > #Body > #Buildings {
    padding: 5px;
}

NewBuildingUI > #Body > #Categories {
    padding: 5px;
}

#BuildingVariants {
    padding: 5px;
}

BuildingPlanElement {
    flex-direction: row;
    border-width: 1px;
    border-color: var(--color-border-alt);
    background-color: var(--color-background-widget);
}

BuildingPlanElement > #SelectionIndicator { 
    display: none;
    width: 10px;
    height: 100%;
    background-color: rgb(255, 255, 255);
    position: absolute;
    right: -10px;
}

BuildingPlanElement.selected > #SelectionIndicator {
    display: flex;
}

BuildingPlanElement:hover {
    background-color: var(--color-background-widget--hovered);
    margin-right: -5px;
    margin-left: 5px;
}

BuildingPlanElement.selected {
    margin-right: -5px;
    margin-left: 5px;
    background-color: var(--color-background-widget--active);
}


BuildingPlanElement > .id-button {
    width: 32px;
    height: 32px;
}