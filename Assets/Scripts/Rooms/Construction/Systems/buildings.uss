NewBuildingUI {
    position: absolute;
    bottom: 0;
    flex-direction: column-reverse;
    align-self: center;
    padding: 10px;
    color: rgb(240, 250, 250);
}

NewBuildingUI > #Buildings {
    flex-direction: row;
    padding: 10px;
}

BuildingPlanElement > #Anchor {
    position: absolute;
    top: -20px;
    left: 50%;
    align-items: center;
}

BuildingPlanElement {
    margin-top: 10px;
}

BuildingPlanElement.selected {
    margin-top: 0;
}

#BuildingVariants {
    position: absolute;
    bottom: 0;
    background-color: rgb(22, 27, 45);
    border-color: rgb(43, 89, 188);
}

#BuildingVariants #unity-content-container {
    flex-direction: row;
}

#BuildingVariants #Recipe {
    border-width: 1px;
    border-color: rgb(43, 89, 188);
    font-size: 12px;
}

#BuildingVariants .id-button {
    width: 42px;
    height: 42px;
}