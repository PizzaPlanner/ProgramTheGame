.id-button {
    width: 48px;
    height: 48px;
    background-color: rgb(46, 44, 44);
    margin-top: 1px;
    margin-right: 1px;
    margin-bottom: 1px;
    margin-left: 1px;
    justify-content: center;
}

.id-button > #Icon {
    position: absolute;
    top: 0;
    right: 0;
    left: 0;
    bottom: 0;
}

.id-button > #Frame {
    position: absolute;
    top: 0;
    right: 0;
    left: 0;
    bottom: 0;
    border-top-width: 1px;
    border-right-width: 1px;
    border-bottom-width: 1px;
    border-left-width: 1px;
    border-left-color: rgb(81, 174, 255);
    border-right-color: rgb(81, 174, 255);
    border-top-color: rgb(81, 174, 255);
    border-bottom-color: rgb(81, 174, 255);
}

InventoryButton {
    margin-top: 1px;
    margin-right: 1px;
    margin-bottom: 1px;
    margin-left: 1px;
    background-image: url("project://database/Assets/UI/InventoryButton-default.png?fileID=2800000&guid=df1b9ebfaeebe894e9734006c36c65ef&type=3#InventoryButton-default");
    -unity-background-image-tint-color: rgb(134, 206, 255);
    width: 48px;
    height: 48px;
    border-top-left-radius: 5px;
    border-top-right-radius: 5px;
    border-bottom-right-radius: 5px;
    border-bottom-left-radius: 5px;
}

InventoryButton > #LockIcon {
    display: none;
    position: absolute;
    top: 0;
    width: 12px;
    height: 12px;
    right: 0;
}

InventoryButton.direction-none > #LockIcon {
    display: flex;
    background-image: url("project://database/Assets/UI/InventorySlotDirection-None.png?fileID=2800000&guid=e24c2d09723a798468e4a08ef0163acd&type=3#InventorySlotDirection-None");
}

InventoryButton.direction-in > #LockIcon {
    display: flex;
    background-image: url("project://database/Assets/UI/InventorySlotDirection-In.png?fileID=2800000&guid=31aba7efd08baa3418769f0498392ea1&type=3#InventorySlotDirection-In");
}

InventoryButton.direction-out > #LockIcon {
    display: flex;
    background-image: url("project://database/Assets/UI/InventorySlotDirection-Out.png?fileID=2800000&guid=42281561bb0f1e145b23934b955d8df9&type=3#InventorySlotDirection-Out");
}

InventoryButton.category-memory {
    background-image: url("project://database/Assets/UI/InventoryButton-memory.png?fileID=2800000&guid=dc602a8877487314b99e2b4ce8dac5ca&type=3#InventoryButton-memory");
}

InventoryButton.category-chip {
    background-image: url("project://database/Assets/UI/InventoryButton-chip.png?fileID=2800000&guid=923035db45bb15641a15563e3ad166cd&type=3#InventoryButton-chip");
}

.id-button.item-button > #Frame {
    display: none;
}

.item-button > Label {
    color: rgb(204, 204, 204);
    background-color: rgba(0, 0, 0, 0.31);
    margin-top: 0;
    margin-right: 0;
    margin-bottom: 0;
    margin-left: 0;
    padding-top: 0;
    padding-right: 2px;
    padding-bottom: 0;
    padding-left: 2px;
    -unity-text-align: middle-center;
    font-size: 12px;
}

.item-button > Label#Name {
    position: absolute;
    top: 0;
    left: 5px;
    right: 5px;
    opacity: 0;
}

.item-button > Label#Stack {
    bottom: 0;
    right: 0;
    position: absolute;
}

InventoryButton:hover {
    -unity-background-image-tint-color: rgb(191, 229, 255);
}

InventoryButton.empty > #Icon {
    opacity: 0.3;
}

CraftingWindow {
}

CraftingRecipeElement {
    background-color: rgba(64, 156, 102, 0.43);
    align-items: flex-start;
    margin-top: 2px;
    margin-right: 2px;
    margin-bottom: 2px;
    margin-left: 2px;
    padding-top: 2px;
    padding-right: 2px;
    padding-bottom: 2px;
    padding-left: 2px;
    border-left-color: rgba(26, 22, 22, 0.69);
    border-right-color: rgba(26, 22, 22, 0.69);
    border-top-color: rgba(26, 22, 22, 0.69);
    border-bottom-color: rgba(26, 22, 22, 0.69);
    border-top-width: 1px;
    border-right-width: 1px;
    border-bottom-width: 1px;
    border-left-width: 1px;
    border-top-left-radius: 3px;
    border-top-right-radius: 3px;
    border-bottom-right-radius: 3px;
    border-bottom-left-radius: 3px;
}

CraftingInputButton {
    width: 48px;
    height: 48px;
    border-left-color: rgba(0, 0, 0, 0.41);
    border-right-color: rgba(0, 0, 0, 0.41);
    border-top-color: rgba(0, 0, 0, 0.41);
    border-bottom-color: rgba(0, 0, 0, 0.41);
    border-top-width: 1px;
    border-right-width: 1px;
    border-bottom-width: 1px;
    border-left-width: 1px;
}

CraftingRecipeElement #Inputs > CraftingInputButton {
    width: 24px;
    height: 24px;
}

CraftingRecipeElement #Inputs > CraftingInputButton.missing {
    background-color: rgba(255, 0, 5, 0.5);
}

CraftingQueueElement {
    height: 8px;
    width: 100%;
}

CraftingQueueElement > .progress-background {
    height: 100%;
    width: 100%;
    flex-shrink: 0;
    background-color: rgb(33, 74, 84);
}

CraftingQueueElement > IdentifiableButton {
    display: none;
}

CraftingQueueElement > .progress-background > .progress-foreground {
    height: 100%;
    width: 100%;
    background-color: rgb(0, 205, 255);
}

InventoryElement {
    flex-direction: column;
    padding-top: 2px;
    padding-right: 2px;
    padding-bottom: 2px;
    padding-left: 2px;
    flex-wrap: wrap;
}

InventoryElement > #Items {
    flex-direction: row;
    flex-grow: 1;
    flex-shrink: 0;
    flex-wrap: wrap;
}

InventoryElement > #Items > InventoryButton {
    width: 36px;
    height: 36px;
}

InventoryElement > #Equipment {
    flex-direction: row;
    flex-grow: 1;
    flex-shrink: 0;
}

CraftingWindow > #OpenRecipes {
    width: 48px;
    height: 48px;
    background-color: rgba(40, 161, 197, 0.62);
}

CraftingWindow > .recipe-list {
    position: absolute;
    left: 80px;
}

CraftingRecipeElement #Inputs {
    flex-direction: row;
}

CraftingRecipeElement #Outputs {
    flex-direction: row;
}

CraftingRecipeElement #Name {
    display: none;
}

IngameMenu {
    position: absolute;
    right: 0;
    bottom: 0;
    flex-direction: row-reverse;
}

IngameMenu > VisualElement {
    width: 32px;
    height: 32px;
    margin-top: 1px;
    margin-right: 1px;
    margin-bottom: 1px;
    margin-left: 1px;
    color: rgb(255, 255, 255);
    background-color: rgb(42, 75, 142);
}

IngameMenu > #Wiki {
    background-image: url("project://database/Assets/3rdParty/2000_Icons/500_weapons/Book_4.png?fileID=2800000&guid=6408704b229edb748b2c6595d880da08&type=3#Book_4");
}

IngameMenu > #Build {
    background-image: url("project://database/Assets/3rdParty/2000_Icons/500_weapons/Hammer_08.png?fileID=2800000&guid=b8929a5a28b17324db90e1efe0ad3622&type=3#Hammer_08");
}

IngameMenu > #Rooms {
    background-image: url("project://database/Assets/3rdParty/2000_Icons/Update_icons/runic_tablet_07.png?fileID=2800000&guid=80c12df18bb265a4bb665cf00931ec59&type=3#runic_tablet_07");
}

IngameMenu > #ChipEditor {
    background-image: url("project://database/Assets/3rdParty/2000_Icons/500_weapons/Book_20.png?fileID=2800000&guid=19ac1da5e8eb2d24e93e4925cea79a06&type=3#Book_20");
}

SignalButton.shows-entity > #Frame {
    border-left-color: rgba(0, 188, 0, 0.76);
    border-right-color: rgba(0, 188, 0, 0.76);
    border-top-color: rgba(0, 188, 0, 0.76);
    border-bottom-color: rgba(0, 188, 0, 0.76);
    border-top-width: 2px;
    border-right-width: 2px;
    border-bottom-width: 2px;
    border-left-width: 2px;
}

SignalButton > Label {
    display: none;
}

SignalButton.with-value > Label {
    display: flex;
    background-color: rgba(0, 0, 0, 0.4);
    color: rgb(255, 255, 255);
    font-size: 11px;
    -unity-text-align: middle-center;
    padding-top: 5px;
    padding-right: 5px;
    padding-bottom: 5px;
    padding-left: 5px;
    margin-top: 0;
    margin-right: 0;
    margin-bottom: 0;
    margin-left: 0;
    align-self: center;
    position: absolute;
}

SignalSelectionIdCollection > Label {
    flex-grow: 1;
    flex-shrink: 0;
    align-self: stretch;
    height: 48px;
    color: rgb(255, 255, 255);
    -unity-font-style: normal;
    font-size: 14px;
    -unity-text-align: middle-left;
    margin-top: 0;
    margin-right: 20px;
    margin-bottom: 0;
    margin-left: 15px;
    padding-top: 0;
    padding-right: 0;
    padding-bottom: 0;
    padding-left: 0;
}

SignalSelectionIdCollection > IntegerField {
    flex-grow: 1;
    flex-shrink: 0;
    align-self: stretch;
    height: 48px;
    -unity-font-style: normal;
    font-size: 14px;
    margin-top: 1px;
    margin-right: 0;
    margin-bottom: 0;
    margin-left: 5px;
    padding-top: 0;
    padding-right: 0;
    padding-bottom: 0;
    padding-left: 0;
    width: 40%;
    border-left-color: rgb(81, 174, 255);
    border-right-color: rgb(81, 174, 255);
    border-top-color: rgb(81, 174, 255);
    border-bottom-color: rgb(81, 174, 255);
}

UnitTaskList {
    flex-direction: row;
}

UnitTaskList > UnitTaskButton.id-button {
    height: 24px;
    width: 24px;
}

UnitTaskList > UnitTaskButton.id-button.first {
    height: 32px;
    width: 32px;
}

UnitTaskButton.cancelable > #Frame {
    border-color: rgb(230, 255, 27);
}

UnitTaskButton.cancelable:hover > #Frame {
    border-width: 3px;
}

UnitOrderList UnitTaskButton.id-button {
    height: 32px;
    width: 32px;
}

UnitOrderButton {
    flex-direction: row;
}

UnitOrderButton > Label {
    flex-shrink: 1;
    white-space: normal;
}

UnitOrderButton > PercentProgressBar {
    display: none;
    position: absolute;
    left: 36px;
    bottom: 0;
    right: 0;
    height: 8px;
    margin: 0;
}

UnitOrderButton.has-progress > PercentProgressBar {
    display: flex;
}

PercentProgressBar > #unity-progress-bar {
    height: 100%;
    min-height: 0;
    max-height: none;
}

UnitOrderButton.has-progress * {
    margin: 0;
}

SelectionWheel {
    padding-top: 3px;
    padding-right: 3px;
    padding-bottom: 3px;
    padding-left: 3px;
    background-color: rgba(0, 0, 0, 0.35);
    border-left-color: rgba(255, 255, 255, 0.53);
    border-right-color: rgba(255, 255, 255, 0.53);
    border-top-color: rgba(255, 255, 255, 0.53);
    border-bottom-color: rgba(255, 255, 255, 0.53);
    border-top-width: 1px;
    border-right-width: 1px;
    border-bottom-width: 1px;
    border-left-width: 1px;
    color: rgb(255, 255, 255);
    -unity-font-style: normal;
    font-size: 16px;
}

SelectionWheelButton {
    padding-top: 5px;
    padding-right: 5px;
    padding-bottom: 5px;
    padding-left: 5px;
    background-color: rgb(0, 73, 130);
    border-left-color: rgb(0, 177, 250);
    border-right-color: rgb(0, 177, 250);
    border-top-color: rgb(0, 177, 250);
    border-bottom-color: rgb(0, 177, 250);
    border-top-width: 2px;
    border-right-width: 2px;
    border-bottom-width: 2px;
    border-left-width: 2px;
}

SystemView {
    padding: 3px;
}


ShipUI {
    min-height: 28px;
    min-width: 50px;
}
ShipUI > #Header {
    background-color: rgba(0, 0, 0, 0.2);
    color: rgb(255, 255, 255);
    flex-direction: row;
}
ShipUI.current-grid > #Header {
    background-color: rgba(150, 100, 0, 0.4);
}

ShipUI > #Header > SignalButton
{
    width: 24px;
    height: 24px;
}

ShipUI > #Header > Button {
    width: 16px;
    height: 16px;
}

ShipUI > #Crew {
    margin-left: 6px;
    flex-direction: row;
}
ShipUI > #Docked {
    margin-left: 6px;
    flex-direction: column;
}
ShipUI SignalButton > IdentifiableButton#CurrentTask {
    width: 24px;
    height: 24px;
    position: absolute;
    bottom: -12px;
    left: 5px;
}

BuildingBuildElement {
    position: absolute;
    bottom: 0;
    flex-direction: row;
    align-self: center;
    padding: 10px;
}

Tooltip {
    background-color: rgb(25, 35, 45);
    border-color: rgb(67, 88, 102);
    border-width: 1px;
    color: rgb(255, 230, 230);
    padding: 5px;
}
Tooltip > Label {
    padding: 0;
    margin: 3px;
}
TooltipTitle {
    font-size: 16px;
}

StatBar {
    flex-direction: row;
    flex-grow: 1;
}

StatBar > .id-button {
    width: 32px;
    height: 32px;
}
StatBar > #Bar {
    margin: 1px;
    height: 32px;
    flex-grow: 1;
    background-color: rgb(15,25,35);
    padding: 2px;
}

StatBar > #Bar > #Progress {
    background-color: rgb(150,180,125);
    flex-grow: 1;
}

StatBar#Lungs > #Bar > #Progress {
    background-color: rgb(104,136,180);
}

StatBar#Stomach > #Bar > #Progress {
    background-color: rgb(10,166,104);
}

StatBar.low > #Bar > #Progress {
    background-color: rgb(180,50,35);
}

StatBar.critical > #Bar > #Progress {
    background-color: rgb(255,35,35);
}


StatsUI > #Stats 
{
    margin: 3px;
    flex-direction: row;
    flex-wrap: wrap;    
}

StatsUI > #Stats > .id-button
{
    height: 24px;
    width: 24px;
}

SelectedUnitElement {
    color: rgb(255, 240, 250);
    background-color: rgba(52, 140, 120, 0.5);
    padding: 5px;
    position: absolute;
    width: 300px;
    height: 500px;
    align-items: stretch;
    bottom: 0;
    left: 0;
}
SelectedUnitElement > #Header {
    flex-direction: row;
}

SelectedUnitElement Foldout
{
    margin: 2px;
    border-color: rgb(25, 32, 11);
    border-width: 1px;
}

SelectedUnitElement Foldout > Toggle
{
    margin: 0;
    flex-direction: row-reverse;
}

SelectedUnitElement Foldout > #unity-content
{
    margin: 2px;
}
