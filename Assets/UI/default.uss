IdentifiableButton {
    width: 48px;
    height: 48px;
    background-color: rgb(46, 44, 44);
    margin-top: 1px;
    margin-right: 1px;
    margin-bottom: 1px;
    margin-left: 1px;
}

IdentifiableButton > #Icon {
    position: absolute;
    top: 0;
    right: 0;
    left: 0;
    bottom: 0;
}

IdentifiableButton > #Frame {
    position: absolute;
    top: 0;
    right: 0;
    left: 0;
    bottom: 0;
    border-top-width: 1px;
    border-right-width: 1px;
    border-bottom-width: 1px;
    border-left-width: 1px;
    border-left-color: rgb(81, 174, 255);
    border-right-color: rgb(81, 174, 255);
    border-top-color: rgb(81, 174, 255);
    border-bottom-color: rgb(81, 174, 255);
}

IdentifiableButton.prefab > #Frame {
    border-left-color: rgb(255, 226, 0);
    border-right-color: rgb(255, 226, 0);
    border-top-color: rgb(255, 226, 0);
    border-bottom-color: rgb(255, 226, 0);
}

UnitGroupElement {
    align-items: center;
}

UnitGroupElement > #Units {
    border-left-color: rgba(0, 225, 255, 0.62);
    border-right-color: rgba(0, 225, 255, 0.62);
    border-top-color: rgba(0, 225, 255, 0.62);
    border-bottom-color: rgba(0, 225, 255, 0.62);
    flex-direction: column;
    align-self: flex-start;
    border-top-width: 2px;
    border-right-width: 2px;
    border-bottom-width: 2px;
    border-left-width: 2px;
    background-color: rgba(0, 170, 255, 0.43);
    position: absolute;
    left: 15px;
    top: 15px;
}

MainUnitElement {
    position: absolute;
    flex-direction: row;
    align-items: flex-start;
    justify-content: center;
    align-self: center;
    top: 0;
}

InventoryButton {
    margin-top: 1px;
    margin-right: 1px;
    margin-bottom: 1px;
    margin-left: 1px;
    background-image: url("project://database/Assets/UI/InventoryButton-default.png?fileID=2800000&guid=df1b9ebfaeebe894e9734006c36c65ef&type=3#InventoryButton-default");
    -unity-background-image-tint-color: rgb(134, 206, 255);
    width: 48px;
    height: 48px;
}

InventoryButton.category-memory {
    background-image: url("project://database/Assets/UI/InventoryButton-memory.png?fileID=2800000&guid=dc602a8877487314b99e2b4ce8dac5ca&type=3#InventoryButton-memory");
}

InventoryButton.category-chip {
    background-image: url("project://database/Assets/UI/InventoryButton-chip.png?fileID=2800000&guid=923035db45bb15641a15563e3ad166cd&type=3#InventoryButton-chip");
}

.item-button > #Icon {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
}

.item-button > Label {
    color: rgb(204, 204, 204);
    background-color: rgba(0, 0, 0, 0.31);
    margin-top: 0;
    margin-right: 0;
    margin-bottom: 0;
    margin-left: 0;
    padding-top: 0;
    padding-right: 2px;
    padding-bottom: 0;
    padding-left: 2px;
    -unity-text-align: middle-center;
    font-size: 12px;
}

.item-button > Label#Name {
    position: absolute;
    top: 0;
    left: 5px;
    right: 5px;
    opacity: 0;
}

.item-button > Label#Stack {
    bottom: 0;
    right: 0;
    position: absolute;
}

InventoryButton:hover {
    -unity-background-image-tint-color: rgb(191, 229, 255);
}

InventoryButton.empty > #Icon {
    opacity: 0.3;
}

EquippedItemActionsElement {
    align-items: flex-start;
    margin-top: 5px;
}

CraftingWindow {
}

CraftingRecipeElement {
    background-color: rgba(64, 156, 102, 0.43);
    align-items: flex-start;
    margin-top: 2px;
    margin-right: 2px;
    margin-bottom: 2px;
    margin-left: 2px;
    padding-top: 2px;
    padding-right: 2px;
    padding-bottom: 2px;
    padding-left: 2px;
    border-left-color: rgba(26, 22, 22, 0.69);
    border-right-color: rgba(26, 22, 22, 0.69);
    border-top-color: rgba(26, 22, 22, 0.69);
    border-bottom-color: rgba(26, 22, 22, 0.69);
    border-top-width: 1px;
    border-right-width: 1px;
    border-bottom-width: 1px;
    border-left-width: 1px;
    border-top-left-radius: 3px;
    border-top-right-radius: 3px;
    border-bottom-right-radius: 3px;
    border-bottom-left-radius: 3px;
}

CraftingInputButton {
    width: 48px;
    height: 48px;
    border-left-color: rgba(0, 0, 0, 0.41);
    border-right-color: rgba(0, 0, 0, 0.41);
    border-top-color: rgba(0, 0, 0, 0.41);
    border-bottom-color: rgba(0, 0, 0, 0.41);
    border-top-width: 1px;
    border-right-width: 1px;
    border-bottom-width: 1px;
    border-left-width: 1px;
}

CraftingRecipeElement #Inputs > CraftingInputButton {
    width: 24px;
    height: 24px;
}

CraftingRecipeElement #Inputs > CraftingInputButton.missing {
    background-color: rgba(255, 0, 5, 0.5);
}

CraftingQueueElement {
    height: 8px;
    width: 100%;
}

CraftingQueueElement > .progress-background {
    height: 100%;
    width: 100%;
    flex-shrink: 0;
    background-color: rgb(33, 74, 84);
}

CraftingQueueElement > IdentifiableButton {
    display: none;
}

CraftingQueueElement > .progress-background > .progress-foreground {
    height: 100%;
    width: 100%;
    background-color: rgb(0, 205, 255);
}

InventoryElement {
    flex-direction: row;
    padding-top: 2px;
    padding-right: 2px;
    padding-bottom: 2px;
    padding-left: 2px;
    flex-shrink: 0;
}

EquippedItemActionsElement > InventoryElement {
    padding-top: 0;
    padding-right: 0;
    padding-bottom: 0;
    padding-left: 0;
}

InventoryElement > #Items {
    flex-direction: row;
    flex-grow: 1;
    flex-shrink: 0;
    flex-wrap: wrap;
}

InventoryElement > #Items > InventoryButton {
    width: 36px;
    height: 36px;
}

InventoryElement > #Equipment {
    margin-left: 48px;
    flex-direction: row;
}

InventoryElement > #Equipment > #EquipWrapper {
    margin-right: 5px;
    margin-left: 5px;
}

CraftingWindow > #OpenRecipes {
    width: 48px;
    height: 48px;
    background-color: rgba(40, 161, 197, 0.62);
}

CraftingWindow > .recipe-list {
    position: absolute;
    left: 80px;
}

CraftingRecipeElement #Inputs {
    flex-direction: row;
}

CraftingRecipeElement #Outputs {
    flex-direction: row;
}

CraftingRecipeElement #Name {
    display: none;
}
