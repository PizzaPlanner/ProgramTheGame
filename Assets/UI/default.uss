:root {
    --color-border-default: rgb(17, 22, 35);
    --color-border-alt-low: rgb(25, 44, 70);
    --color-border-alt: rgb(25, 80, 110);
    --color-border-widget: rgb(40, 60, 100);
    --color-background-default: rgba(24, 32, 45, 0.9);
    --color-background-alt: rgba(33, 48, 66, 0.7);
    --color-background-widget: rgb(20, 30, 40);
    --color-background-widget--hovered: rgb(15, 25, 45);
    --color-background-widget--active: rgb(22, 44, 85);
    --color-foreground-bright: rgb(44, 200, 144);
    --color-foreground-fancy: rgb(22, 100, 77);
    --color-text-default: rgb(255, 255, 255);
}

Scroller > RepeatButton {
    display: none;
}

Scroller { 
    align-items: center;
    width: auto;
    height: auto;
}

Scroller > ScrollerSlider {
    background-color: transparent;
    margin: 0;
    width: 8px;
    min-width: 8px;
    height: 8px;
    min-height: 8px;
}
.unity-base-slider .unity-base-slider__tracker {
    background-color: var(--color-border-default);
    border-width: 0;
}
.unity-base-slider .unity-base-slider__dragger {
    background-color: var(--color-border-alt);
    border-width: 0;
    left: 0;
    top: 0;
    margin: 0;
}
.unity-base-slider--horizontal .unity-base-slider__dragger {
    height: 100%;
}
.unity-base-slider--vertical .unity-base-slider__dragger {
    width: 100%;
}

.id-button {
    width: 48px;
    height: 48px;
    background-color: rgb(46, 44, 44);
    margin: 1px;
    justify-content: center;
}

.id-button > #Icon {
    position: absolute;
    top: 0;
    right: 0;
    left: 0;
    bottom: 0;
}

.id-button > #Frame {
    position: absolute;
    top: 0;
    right: 0;
    left: 0;
    bottom: 0;
    border-width: 1px;
    border-color: var(--color-border-alt);
}

InventoryButton {
    margin-top: 1px;
    margin-right: 1px;
    margin-bottom: 1px;
    margin-left: 1px;
    background-image: url("project://database/Assets/UI/InventoryButton-default.png?fileID=2800000&guid=df1b9ebfaeebe894e9734006c36c65ef&type=3#InventoryButton-default");
    -unity-background-image-tint-color: rgb(134, 206, 255);
    width: 48px;
    height: 48px;
    border-top-left-radius: 5px;
    border-top-right-radius: 5px;
    border-bottom-right-radius: 5px;
    border-bottom-left-radius: 5px;
}

InventoryButton > #LockIcon {
    display: none;
    position: absolute;
    top: 0;
    width: 12px;
    height: 12px;
    right: 0;
}

InventoryButton.direction-none > #LockIcon {
    display: flex;
    background-image: url("project://database/Assets/UI/InventorySlotDirection-None.png?fileID=2800000&guid=e24c2d09723a798468e4a08ef0163acd&type=3#InventorySlotDirection-None");
}

InventoryButton.direction-in > #LockIcon {
    display: flex;
    background-image: url("project://database/Assets/UI/InventorySlotDirection-In.png?fileID=2800000&guid=31aba7efd08baa3418769f0498392ea1&type=3#InventorySlotDirection-In");
}

InventoryButton.direction-out > #LockIcon {
    display: flex;
    background-image: url("project://database/Assets/UI/InventorySlotDirection-Out.png?fileID=2800000&guid=42281561bb0f1e145b23934b955d8df9&type=3#InventorySlotDirection-Out");
}

InventoryButton.category-memory {
    background-image: url("project://database/Assets/UI/InventoryButton-memory.png?fileID=2800000&guid=dc602a8877487314b99e2b4ce8dac5ca&type=3#InventoryButton-memory");
}

InventoryButton.category-chip {
    background-image: url("project://database/Assets/UI/InventoryButton-chip.png?fileID=2800000&guid=923035db45bb15641a15563e3ad166cd&type=3#InventoryButton-chip");
}

.id-button.item-button > #Frame {
    display: none;
}

.item-button > Label {
    color: rgb(204, 204, 204);
    background-color: rgba(0, 0, 0, 0.31);
    margin-top: 0;
    margin-right: 0;
    margin-bottom: 0;
    margin-left: 0;
    padding-top: 0;
    padding-right: 2px;
    padding-bottom: 0;
    padding-left: 2px;
    -unity-text-align: middle-center;
    font-size: 12px;
}

.item-button > Label#Name {
    position: absolute;
    top: 0;
    left: 5px;
    right: 5px;
    opacity: 0;
}

.item-button > Label#Stack {
    bottom: 0;
    right: 0;
    position: absolute;
}

InventoryButton:hover {
    -unity-background-image-tint-color: rgb(191, 229, 255);
}

InventoryButton.empty > #Icon {
    opacity: 0.3;
}

CraftOrderWindow > #Orders {
    border-bottom-width: 1px;
    border-color: var(--color-border-widget);
    margin: 8px;
    padding-bottom: 8px;
    flex-direction: row;
}

CraftOrderWindow #InOut {
    flex-direction: row;
    justify-content: space-between;
}

CraftOrderWindow #In {
    flex-direction: row;
}
CraftOrderWindow #Out {
    flex-direction: row;
}

CraftOrderWindow > #CraftOrder {
    flex-direction: row;
    font-size: 12px;
}
CraftOrderWindow .id-button {
    width: 32px;
    height: 32px;
}

CraftOrderWindow > #CraftOrder #unity-text-input {
    width: 55px;
    padding: 6px;
}

CraftingInputButton {
    width: 48px;
    height: 48px;
    border-left-color: rgba(0, 0, 0, 0.41);
    border-right-color: rgba(0, 0, 0, 0.41);
    border-top-color: rgba(0, 0, 0, 0.41);
    border-bottom-color: rgba(0, 0, 0, 0.41);
    border-top-width: 1px;
    border-right-width: 1px;
    border-bottom-width: 1px;
    border-left-width: 1px;
}

CraftingRecipeElement #Inputs > CraftingInputButton {
    width: 24px;
    height: 24px;
}

CraftingRecipeElement #Inputs > CraftingInputButton.missing {
    background-color: rgba(255, 0, 5, 0.5);
}

InventoryElement {
    flex-direction: column;
    padding-top: 2px;
    padding-right: 2px;
    padding-bottom: 2px;
    padding-left: 2px;
    flex-wrap: wrap;
}

InventoryElement > #Items {
    flex-direction: row;
    flex-grow: 1;
    flex-shrink: 0;
    flex-wrap: wrap;
}

InventoryElement > #Items > InventoryButton {
    width: 36px;
    height: 36px;
}

InventoryElement > #Equipment {
    flex-direction: row;
    flex-grow: 1;
    flex-shrink: 0;
}

CraftingWindow > #OpenRecipes {
    width: 48px;
    height: 48px;
    background-color: rgba(40, 161, 197, 0.62);
}

CraftingWindow > .recipe-list {
    position: absolute;
    left: 80px;
}

CraftingRecipeElement #Inputs {
    flex-direction: row;
}

CraftingRecipeElement #Outputs {
    flex-direction: row;
}

CraftingRecipeElement #Name {
    display: none;
}

IngameMenu {
    position: absolute;
    right: 0;
    bottom: 0;
    flex-direction: row-reverse;
}

IngameMenu > VisualElement {
    width: 32px;
    height: 32px;
    margin-top: 1px;
    margin-right: 1px;
    margin-bottom: 1px;
    margin-left: 1px;
    color: rgb(255, 255, 255);
    background-color: rgb(42, 75, 142);
}

IngameMenu > #Wiki {
    background-image: url("project://database/Assets/3rdParty/2000_Icons/500_weapons/Book_4.png?fileID=2800000&guid=6408704b229edb748b2c6595d880da08&type=3#Book_4");
}

IngameMenu > #Build {
    background-image: url("project://database/Assets/3rdParty/2000_Icons/500_weapons/Hammer_08.png?fileID=2800000&guid=b8929a5a28b17324db90e1efe0ad3622&type=3#Hammer_08");
}

IngameMenu > #Rooms {
    background-image: url("project://database/Assets/3rdParty/2000_Icons/Update_icons/runic_tablet_07.png?fileID=2800000&guid=80c12df18bb265a4bb665cf00931ec59&type=3#runic_tablet_07");
}

IngameMenu > #ChipEditor {
    background-image: url("project://database/Assets/3rdParty/2000_Icons/500_weapons/Book_20.png?fileID=2800000&guid=19ac1da5e8eb2d24e93e4925cea79a06&type=3#Book_20");
}

IngameMenu > #TemperatureOverlay {
    background-image: url("project://database/Assets/3rdParty/64%20flat%20icons/png/64px/Inventory_PotionSmall.png?fileID=2800000&guid=cd108ac1e6a3b8a49929c82009040ada&type=3#Inventory_PotionSmall");
}

IngameMenu > #PressureOverlay {
    background-image: url("project://database/Assets/3rdParty/64%20flat%20icons/png/64px/Modifiers_Luck.png?fileID=2800000&guid=d7bfe709e7c05f54fbef7ab6c7979ebb&type=3#Modifiers_Luck");
}

.overlayPopup {
    border-width: 2px;
    border-color: var(--color-border-default);
    background-color: var(--color-background-default);
    color: var(--color-text-default);
    position: absolute;
    bottom: 36px;
    right: 5px;
}

SignalButton.shows-entity > #Frame {
    border-color: var(--color-foreground-bright);
    border-top-width: 1px;
    border-right-width: 1px;
    border-bottom-width: 1px;
    border-left-width: 1px;
}

SignalButton > Label {
    display: none;
}

SignalButton.with-value > Label {
    display: flex;
    background-color: rgba(0, 0, 0, 0.4);
    color: rgb(255, 255, 255);
    font-size: 11px;
    -unity-text-align: middle-center;
    padding-top: 5px;
    padding-right: 5px;
    padding-bottom: 5px;
    padding-left: 5px;
    margin-top: 0;
    margin-right: 0;
    margin-bottom: 0;
    margin-left: 0;
    align-self: center;
    position: absolute;
}

SignalSelectionIdCollection > Label {
    flex-grow: 1;
    flex-shrink: 0;
    align-self: stretch;
    height: 48px;
    color: rgb(255, 255, 255);
    -unity-font-style: normal;
    font-size: 14px;
    -unity-text-align: middle-left;
    margin-top: 0;
    margin-right: 20px;
    margin-bottom: 0;
    margin-left: 15px;
    padding-top: 0;
    padding-right: 0;
    padding-bottom: 0;
    padding-left: 0;
}

#unity-text-input {
    background-color: var(--color-background-widget);
    border-color: var(--color-border-widget);
    border-width: 1px;
    color: var(--color-text-default);
    padding: 0 8px;
}

SignalSelectionIdCollection > IntegerField {
    flex-grow: 1;
    flex-shrink: 0;
    align-self: stretch;
    height: 48px;
    -unity-font-style: normal;
    font-size: 14px;
    margin-top: 1px;
    margin-right: 0;
    margin-bottom: 0;
    margin-left: 5px;
    padding-top: 0;
    padding-right: 0;
    padding-bottom: 0;
    padding-left: 0;
    width: 40%;
    border-left-color: rgb(81, 174, 255);
    border-right-color: rgb(81, 174, 255);
    border-top-color: rgb(81, 174, 255);
    border-bottom-color: rgb(81, 174, 255);
}

UnitTaskList {
    flex-direction: row;
    flex-wrap: wrap;
}

UnitTaskList > UnitTaskButton.id-button {
    height: 24px;
    width: 24px;
}

UnitTaskList > UnitTaskButton.id-button.first {
    height: 32px;
    width: 32px;
}

UnitTaskList > UnitTaskButton.ignored {
    opacity: 0.5;
}

UnitTaskButton.cancelable > #Frame {
    border-color: rgb(230, 255, 27);
}

UnitTaskButton.cancelable:hover > #Frame {
    border-width: 3px;
}

UnitOrderList UnitTaskButton.id-button {
    height: 32px;
    width: 32px;
}

UnitOrderButton {
    flex-direction: row;
}

UnitOrderButton > Label {
    flex-shrink: 1;
    white-space: normal;
}

UnitOrderButton > PercentProgressBar {
    display: none;
    position: absolute;
    left: 36px;
    top: 1px;
    right: 5px;
    height: 6px;
    margin: 0;
}

UnitOrderButton.has-progress > PercentProgressBar {
    display: flex;
    background-color: rgb(55, 55, 55);
}

PercentProgressBar {
    border-color: rgb(200,200,200);
    border-width: 1px;
    min-height: 6px;
}

PercentProgressBar > #Progress {
    height: 100%;
    min-height: 0;
    max-height: none;
    background-color: rgb(200, 200, 200);
    margin: 1px;
}

SelectionWheel {
    padding-top: 3px;
    padding-right: 3px;
    padding-bottom: 3px;
    padding-left: 3px;
    background-color: rgba(0, 0, 0, 0.35);
    border-left-color: rgba(255, 255, 255, 0.53);
    border-right-color: rgba(255, 255, 255, 0.53);
    border-top-color: rgba(255, 255, 255, 0.53);
    border-bottom-color: rgba(255, 255, 255, 0.53);
    border-top-width: 1px;
    border-right-width: 1px;
    border-bottom-width: 1px;
    border-left-width: 1px;
    color: rgb(255, 255, 255);
    -unity-font-style: normal;
    font-size: 16px;
}

SelectionWheelButton {
    padding-top: 5px;
    padding-right: 5px;
    padding-bottom: 5px;
    padding-left: 5px;
    background-color: rgb(0, 73, 130);
    border-left-color: rgb(0, 177, 250);
    border-right-color: rgb(0, 177, 250);
    border-top-color: rgb(0, 177, 250);
    border-bottom-color: rgb(0, 177, 250);
    border-top-width: 2px;
    border-right-width: 2px;
    border-bottom-width: 2px;
    border-left-width: 2px;
}

SystemView {
    padding: 3px;
}

PlayfieldUI {
    min-height: 28px;
    min-width: 50px;
    background-color: var(--color-background-default);
    color: var(--color-text-default);
    margin-top: 2px;
    border-color: var(--color-border-default);
    border-width: 1px;
}

PlayfieldUI > #Header {
    flex-direction: row;
    align-items: center;
    background-color: var(--color-border-default);
    padding: 1px;
}

PlayfieldUI > #Header > Label {
    width: 120px;
}

PlayfieldUI.current-grid {
    border-color: var(--color-border-alt-low);
}

PlayfieldUI.current-grid > #Header {
    background-color: var(--color-border-alt-low);
}

PlayfieldUI > #Header > SignalButton {
    width: 32px;
    height: 32px;
}

PlayfieldUI > #Header > Button {
    width: 24px;
    height: 24px;
}

PlayfieldUI > #Crew {
    flex-direction: row;
    padding: 2px;
}

PlayfieldUI > #Crew > .id-button {
    width: 36px;
    height: 36px;
}

PlayfieldUI > #TravelState {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
}

PlayfieldUI > #TravelState > PercentProgressBar {
    position: absolute;
    top: 3px;
    left: 26px;
    right: 26px;
    bottom: 2px;
}

PlayfieldUI > #TravelState > PercentProgressBar > #Progress {
    background-color: var(--color-foreground-fancy);
}

PlayfieldUI > #TravelState > .id-button {
    width: 24px;
    height: 24px;
}


PlayfieldUI SignalButton > IdentifiableButton#CurrentTask {
    width: 24px;
    height: 24px;
    position: absolute;
    bottom: -12px;
    left: 5px;
}

Tooltip {
    border-color: var(--color-border-alt);
    background-color: var(--color-background-alt);
    color: var(--color-text-default);
    border-width: 1px;
    padding: 5px;
}

Tooltip > Label {
    padding: 0;
    margin: 3px;
}

TooltipTitle {
    font-size: 16px;
}

Tooltip .id-button {
    width: 28px;
    height: 28px;
}

StatBar {
    flex-direction: row;
    flex-grow: 1;
}

StatBar > .id-button {
    width: 32px;
    height: 32px;
}

StatBar > #Bar {
    margin: 1px;
    height: 32px;
    flex-grow: 1;
    background-color: rgb(15, 25, 35);
    padding: 2px;
}

#Needs {
    flex-direction: row;
    align-self: flex-start;
}

#Needs StatBar {
    background-image: url("project://database/Assets/UI/bg_default.png?fileID=2800000&guid=6fcdc6be826fab74280e89ce24ab0614&type=3#bg_default");
    -unity-background-image-tint-color: rgb(15, 25, 35);
    flex-direction: column;
    margin: 1px;
}

#Needs > StatBar > .id-button {
    margin: 4px 4px 0 4px;
    width: 32px;
    height: 32px;
    background-color: rgba(0, 0, 0, 0);
}

#Needs > StatBar > .id-button > #Frame {
    display: none;
}

#Needs > StatBar > #Bar {
    margin: 0;
    padding: 1px;
    height: 6px;
    background-color: rgba(0, 0, 0, 0);
}

StatBar > #Bar > #Progress {
    background-color: rgb(150, 180, 125);
    flex-grow: 1;
}

#Needs > StatBar > #Bar > #Progress {
    background-color: rgb(255, 255, 255);
}

#Needs StatBar.level3 {
    -unity-background-image-tint-color: rgb(0, 100, 80);
}

#Needs StatBar.level3 > #Bar > #Progress {
    background-color: rgb(0, 240, 170);
}

#Needs StatBar.level3 > .id-button > #Icon {
    -unity-background-image-tint-color: rgb(0, 240, 170);
}

#Needs StatBar.level2 {
    -unity-background-image-tint-color: rgb(30, 80, 0);
}

#Needs StatBar.level2 > #Bar > #Progress {
    background-color: rgb(70, 230, 80);
}

#Needs StatBar.level2 > .id-button > #Icon {
    -unity-background-image-tint-color: rgb(70, 230, 80);
}

#Needs StatBar.level1 {
    -unity-background-image-tint-color: rgb(55, 70, 0);
}

#Needs StatBar.level1 > #Bar > #Progress {
    background-color: rgb(180, 220, 80);
}

#Needs StatBar.level1 > .id-button > #Icon {
    -unity-background-image-tint-color: rgb(180, 220, 80);
}

#Needs StatBar.level-1 {
    -unity-background-image-tint-color: rgb(70, 55, 0);
}

#Needs StatBar.level-1 > #Bar > #Progress {
    background-color: rgb(210, 190, 80);
}

#Needs StatBar.level-1 > .id-button > #Icon {
    -unity-background-image-tint-color: rgb(210, 190, 80);
}

#Needs StatBar.level-2 {
    -unity-background-image-tint-color: rgb(68, 32, 0);
}

#Needs StatBar.level-2 > #Bar > #Progress {
    background-color: rgb(200, 150, 44);
}

#Needs StatBar.level-2 > .id-button > #Icon {
    -unity-background-image-tint-color: rgb(200, 150, 44);
}

#Needs StatBar.level-3 {
    -unity-background-image-tint-color: rgb(82, 0, 0);
}

#Needs StatBar.level-3 > #Bar > #Progress {
    background-color: rgb(255, 35, 35);
}

#Needs StatBar.level-3 > .id-button > #Icon {
    -unity-background-image-tint-color: rgb(255, 35, 35);
}

SkillsUI {
    flex-direction: row;
    justify-content: space-around;
}

StatsUI > #Stats {
    margin: 3px;
    flex-direction: row;
    flex-wrap: wrap;
}

StatsUI > #Stats > .id-button {
    height: 24px;
    width: 24px;
}

SelectedUnitElement {
    border-width: 1px;
    border-color: var(--color-border-default);
    background-color: var(--color-background-default);
    color: var(--color-text-default);
    padding: 5px;
    position: absolute;
    width: 300px;
    height: 500px;
    align-items: stretch;
    bottom: 0;
    left: 0;
}

SelectedUnitElement > #Header {
    flex-direction: row;
    flex-shrink: 0;
    -unity-text-align: middle-left;
}

SelectedUnitElement Foldout {
    margin: 2px;
    border-color: var(--color-border-alt);
    background-color: var(--color-background-alt);
    border-width: 1px;
}

SelectedUnitElement Foldout > Toggle {
    margin: 0;
    flex-direction: row-reverse;
}

SelectedUnitElement Foldout > #unity-content {
    margin: 2px;
}

SelectionMarker {
    justify-content: center;
    align-items: center;
}

SelectionMarker > VisualElement {
    min-height: 24px;
    min-width: 24px;
    border-color: rgb(60, 160, 240);
    color: rgb(60, 160, 240);
    border-width: 2px 0;
    border-radius: 10px;
    position: absolute;
    justify-content: space-between;
}

SelectionMarker Label {
    margin: -30px 0;
    text-shadow: 1px 1px 3px rgb(0, 0, 0);
}

ActiveOrderMarker > .id-button {
    position: absolute;
    width: 24px;
    height: 24px;
    top: -12px;
}

MassVolumeUI > #MolesContainer {
    flex-direction: row;
}

MassVolumeUI > #MolesContainer > IdentifiableButton {
    width: 32px;
    height: 32px;
    margin-bottom: 24px;
}

MassVolumeUI > #MolesContainer > IdentifiableButton > Label {
    background-color: rgba(0, 0, 0, 0.5);
    position: absolute;
    padding: 2px;
    bottom: -24px;
}

SkillButton {
    width: 56px;
    height: 80px;
    padding-top: 8px;
    align-items: center;
    align-content: center;
}

SkillButton.rank0 > PercentProgressBar {
    display: none;
}

SkillButton > PercentProgressBar {
    background-image: url("project://database/Assets/UI/RankExpMask.svg?fileID=7388822144124034973&guid=d6693b716b0a8624caba28e969e65678&type=3#RankExpMask");
    height: 21px;
    width: 42px;
    margin-bottom: 8px;
    overflow: hidden;
}

SkillButton > PercentProgressBar > #Progress {
    background-color: rgb(25, 200, 60);
    height: 100%;
    margin: 0;
}

SkillButton > .id-button {
    width: 42px;
    height: 42px;
    background-color: rgba(0, 0, 0, 0);
}

SkillButton > .id-button > #Frame {
    border-width: 0;
    overflow: hidden;
}

SkillButton.rank0 {
    background-image: url("project://database/Assets/UI/Rank0.svg?fileID=7388822144124034973&guid=be707f2eafa0cb14ead4efc8eb9e725b&type=3#Rank0");
}

SkillButton.rank1 {
    background-image: url("project://database/Assets/UI/Rank1.svg?fileID=7388822144124034973&guid=f8b4721f01956da449ad5ae0fc02966d&type=3#Rank1");
}

SkillButton.rank2 {
    background-image: url("project://database/Assets/UI/Rank3.svg?fileID=7388822144124034973&guid=e4afa36223fe7ff49b68dad0279e0312&type=3#Rank3");
}

SkillButton.rank3 {
    background-image: url("project://database/Assets/UI/Rank3.svg?fileID=7388822144124034973&guid=e4afa36223fe7ff49b68dad0279e0312&type=3#Rank3");
}

CreateTaskButton > #Header {
    flex-direction: row;
    align-items: center;
}
CreateTaskButton > #Header > Button {
    flex-grow: 1;
    padding: 4px;
    margin: 2px;
}

CreateTaskButton > #Header > SkillButton {
    width: 36px;
    height: 48px;
    padding-top: 4px;
    position: absolute;
    right: 5px;
    top: -2px;
}

CreateTaskButton > #Header > SkillButton > .id-button {
    width: 28px;
    height: 28px;
}

CreateTaskButton > #Header .id-button {
    width: 32px;
    height: 32px;
}

CreateTaskButton > #Header > SkillButton > PercentProgressBar {
    display: none;
}

ConfigPanel {
    padding: 4px;
    margin: -3px 2px 2px 12px;
    background-color: var(--color-background-widget);
    border-color: var(--color-border-widget);
    border-width: 1px;
}

ConfigPanel > #Header {
    flex-direction: row;
}

ConfigPanel.planned > #Header { 
    display: none;
}

ConfigPanel > PercentProgressBar {
    display: none;
    margin: 4px 1px;
    height: 8px;
}

ConfigPanel > #Header Label {
    margin: 0;
    flex-grow: 1;
    -unity-text-align: middle-center;
}

ConfigPanel.cannot-cancel > #Header > Button#Cancel
{
    display: none;
}

ConfigPanel.personal > #Header > SignalButton
{
    display: none;
}

ConfigPanel.has-progress > PercentProgressBar {
    display: flex;
}

ConfigPanel > #Header .id-button {
    width: 24px;
    height: 24px;
}

Button#Cancel {
    background-color: rgb(82, 0, 0);
    width: 24px;
    height: 24px;
    margin: 0;
    padding: 5px;
    padding-bottom: 7px;
}
Button#Cancel:hover {
    background-color: rgb(155, 0, 0);
}

MassBeingUI {
    flex-direction: row;
}

.unity-base-field:focus Label {
    color: rgb(255, 255, 255);
}

IntegerField > Label {
    min-width: 20px;
}

IntegerInput {
    background-color: var(--color-background-widget);
    border-color: var(--color-border-widget);
}

IntegerInput:hover {
    background-color: var(--color-background-widget--hovered);
}

Button {
    background-color: var(--color-background-widget);
    border-color: var(--color-border-widget);
}

Button:hover {
    background-color: var(--color-background-widget--hovered);
}

TravelUI > #Planner {
    border-color: var(--color-border-alt);
    background-color: var(--color-background-alt);
    color: var(--color-text-default);
    border-width: 1px;
    padding: 8px;
}

TimeUI {
    position: absolute;
    top: 0;
    right: 0;
    background-color: var(--color-background-default);
    color: var(--color-text-default);
    font-size: 12px;
}

TimeUI > VisualElement {
    flex-direction: row;
}

TimeUI Button {
    width: 16px;
    height: 16px;
    background-color: var(--color-border-widget);
}
TimeUI Button.active {
    width: 16px;
    height: 16px;
    background-color: var(--color-border-alt-low);
}

ToggleButtonGroup#Tasks {
    flex-direction: row;
    flex-wrap: wrap;
}

ToggleButtonGroup#Tasks .id-button{
    width: 24px;
    height: 24px;
}

.unity-toggle__checkmark { 
    width: 20px;
    height: 20px;
    margin: 2px;
    background-color: var(--color-background-widget);
    border-color: var(--color-border-widget);
    -unity-background-image-tint-color: var(--color-foreground-bright) ;
}

MainMenu {
    position: absolute;
    width: 220px;
    top: 20%;
    left: 15%;
    color: var(--color-text-default);
}

#SandboxAddSector {
    position: absolute;
    right: -32px;
    width: 32px;
    height: 32px;
}

#BuildTaskInput {
    flex-direction: row;
}

#BuildTaskInput > .id-button {
    width: 24px;
    height: 24px;
}

UnitButtonWithMood > PercentProgressBar {
    position: absolute;
    bottom: 0;
    width: 100%;
}

GalaxyMapUI {
    position: absolute;
    top: 0;
    bottom: 0;
    left: 0;
    right: 0;
    background-color: rgba(0,0,0, 0.6);
    flex-direction: row;
    color: var(--color-text-default);
}

GalaxyMapElement {
}

GalaxyMapElement > #Outer {
    border-width: 2px;
    border-color: rgb(255,255,255);
    overflow: scroll;
    width: 700px;
    height: 700px;
}

GalaxyMapElement > #Outer > #Inner {
    position: absolute;
    border-width: 2px;
    border-color: rgb(255,0, 0);
    overflow: scroll;
    width: 400%;
    height: 400%;
    transform-origin: 0 0;
}

ShipElement.id-button {
    margin: 0;
    width: 32px;
    height: 32px;
    background-color: rgba(0,0,0,0);
    position: absolute;
}

ShipElement.id-button > #Frame {
    display: none;
}

GalaxyCell.id-button {
    margin: 0;
    width: 64px;
    height: 64px;
    background-color: rgba(0,0,0,0);
    border-width: 1px;
    border-color: rgba(50, 50, 100, 0.5);
}

GalaxyCell.id-button.unknown {
    background-color: rgba(0,0,0,0.8);
    border-color: rgba(20, 20, 20, 0.5);
}

GalaxyCell.id-button > Label {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    -unity-text-align: lower-center;
    color: rgba(255, 255, 255, 0.4);
}

GalaxyCell.id-button > #Frame {
display: none;
}